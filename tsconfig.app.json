{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "baseUrl": ".",

    "paths": {
      "@base/*": ["../cht-base/src/*"],
      "@shared/*": ["../cht-shared/src/*"],
      // Sidebar types the globally registered `RouterLink`/`RouterView`; the
      // router itself is provided by the host app at runtime.
      "vue-router": ["../cht-base/node_modules/vue-router"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ]
}
